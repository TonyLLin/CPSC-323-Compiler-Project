# --- SYMBOL TABLE ---
class SymbolTable:
    def __init__(self):
        self.table = {}
        self.memory_address_counter = 10000

    def insert(self, lexeme, var_type):
        if lexeme in self.table:
            raise Exception(f"Error: Identifier '{lexeme}' is already declared.")
        self.table[lexeme] = {
            'address': self.memory_address_counter,
            'type': var_type
        }
        self.memory_address_counter += 1

    def lookup(self, lexeme):
        if lexeme not in self.table:
            raise Exception(f"Error: Identifier '{lexeme}' used without declaration.")
        return self.table[lexeme]

    def print_table(self):
        print("\nSymbol Table")
        print(f"{'Identifier':<15} {'MemoryLocation':<15} {'Type':<10}")
        for name, info in self.table.items():
            print(f"{name:<15} {info['address']:<15} {info['type']:<10}")

# --- CODE GENERATOR ---
class CodeGenerator:
    def __init__(self):
        self.instructions = []

    def gen_instr(self, op, operand=""):
        self.instructions.append(f"{op} {operand}".strip())
        return len(self.instructions) # Returns the current 1-based index

    def backpatch(self, index, target):
        # index is 1-based from gen_instr
        self.instructions[index-1] = f"{self.instructions[index-1]} {target}"

    def get_next_index(self):
        return len(self.instructions) + 1

    def print_asm(self):
        print("\nAssembly Code Listing")
        for i, instr in enumerate(self.instructions):
            print(f"{i+1} {instr}")

